{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Go Actions Configuration",
    "description": "Configuration schema for .go-actions.yaml files",
    "type": "object",
    "properties": {
        "version": {
            "type": "number",
            "const": 1,
            "description": "Configuration file format version"
        },
        "ci": {
            "type": "object",
            "description": "CI workflow configuration",
            "properties": {
                "go": {
                    "type": "object",
                    "description": "Go version configuration",
                    "properties": {
                        "version": {
                            "type": "string",
                            "description": "Explicit Go version (e.g., '1.21', overrides version-file)"
                        },
                        "version-file": {
                            "type": "string",
                            "description": "Path to file containing Go version (default: go.mod)"
                        }
                    }
                },
                "test": {
                    "type": "object",
                    "description": "Test configuration",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable test job"
                        },
                        "args": {
                            "type": "string",
                            "description": "Arguments passed to 'go test'"
                        },
                        "coverage": {
                            "type": "object",
                            "description": "Coverage configuration",
                            "properties": {
                                "enabled": {
                                    "type": "boolean",
                                    "description": "Enable coverage reporting"
                                },
                                "threshold": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 100,
                                    "description": "Minimum coverage percentage (0-100)"
                                }
                            }
                        }
                    }
                },
                "lint": {
                    "type": "object",
                    "description": "Lint configuration",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable lint job"
                        },
                        "version": {
                            "type": "string",
                            "description": "golangci-lint version (e.g., 'v2.0.2')"
                        },
                        "args": {
                            "type": "string",
                            "description": "Additional arguments passed to golangci-lint"
                        }
                    }
                },
                "benchmark": {
                    "type": "object",
                    "description": "Benchmark configuration",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable benchmark job"
                        },
                        "args": {
                            "type": "string",
                            "description": "Arguments passed to 'go test' for benchmarks"
                        },
                        "count": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Number of benchmark iterations"
                        }
                    }
                },
                "security": {
                    "type": "object",
                    "description": "Security scanning configuration",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable security scanning job"
                        },
                        "version": {
                            "type": "string",
                            "description": "govulncheck version (e.g., 'latest')"
                        },
                        "args": {
                            "type": "string",
                            "description": "Additional arguments passed to govulncheck"
                        },
                        "fail-on": {
                            "type": "string",
                            "enum": ["critical", "high", "medium", "low", "none"],
                            "description": "Severity level to fail build on"
                        }
                    }
                }
            }
        },
        "release": {
            "type": "object",
            "description": "Release workflow configuration",
            "properties": {
                "strategy": {
                    "type": "string",
                    "enum": ["release-please", "goreleaser", "manual"],
                    "description": "Release strategy to use"
                },
                "release-please": {
                    "type": "object",
                    "description": "Release Please specific configuration",
                    "properties": {
                        "release-type": {
                            "type": "string",
                            "description": "Release Please release type"
                        },
                        "extra-files": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Additional files to update version in"
                        }
                    }
                },
                "goreleaser": {
                    "type": "object",
                    "description": "GoReleaser specific configuration",
                    "properties": {
                        "args": {
                            "type": "string",
                            "description": "Additional arguments passed to goreleaser"
                        }
                    }
                }
            }
        },
        "local": {
            "type": "object",
            "description": "Local development and CLI configuration",
            "properties": {
                "hooks": {
                    "type": "object",
                    "description": "Git hooks configuration",
                    "properties": {
                        "pre-commit": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Commands to run on pre-commit"
                        },
                        "pre-push": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Commands to run on pre-push"
                        }
                    }
                },
                "agent": {
                    "type": "object",
                    "description": "AI agent features configuration",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable AI agent features"
                        },
                        "auto-fix": {
                            "type": "boolean",
                            "description": "Automatically fix issues when possible"
                        }
                    }
                }
            }
        },
        "output": {
            "type": "object",
            "description": "Output formatting configuration",
            "properties": {
                "format": {
                    "type": "string",
                    "enum": ["auto", "json", "text", "markdown"],
                    "description": "Output format for reports"
                },
                "verbosity": {
                    "type": "string",
                    "enum": ["quiet", "normal", "verbose", "debug"],
                    "description": "Verbosity level for output"
                }
            }
        }
    },
    "required": ["version"]
}
